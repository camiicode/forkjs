{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*.chess.com"
    ]
  },
  "permissions": [
    "core:default",
    "allow-get-best-moves",
    "allow-explain-move"
  ]
}
